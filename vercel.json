{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/cdo-news",
      "destination": "/api/cdo-news"
    },
    {
      "source": "/api/cdo-ai-search",
      "destination": "/api/cdo-ai-search"
    },
    {
      "source": "/api/send-test-notification",
      "destination": "/api/send-test-notification"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
